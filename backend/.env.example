# Server
NODE_ENV=development
PORT=4000

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/odoo"

# JWT — use long random strings in production (openssl rand -hex 64)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cookies (refresh token)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# Email — Brevo (formerly Sendinblue) SMTP
# Get credentials from: Brevo dashboard → SMTP & API → SMTP
# EMAIL_FROM_ADDRESS must be a verified sender in Brevo (single sender or verified domain)
# All four EMAIL_SMTP_* vars + EMAIL_FROM_ADDRESS are REQUIRED — the app will not start without them.
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-brevo-account-email@example.com
EMAIL_SMTP_PASS=your-brevo-smtp-key
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=PeoplePay360
